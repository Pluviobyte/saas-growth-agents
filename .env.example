# 复制成 .env（权限 600）再填。不要提交真实的值，也不要把 Key 贴进聊天。
# 最好的做法：Key 放在 Bot 的保险库里，运行前再读进环境变量。

# AIsa（必填）。https://console.aisa.one 创建
AISA_API_KEY=
# 可选：两个 Key 轮流用，分摊限速（配了就优先用这两个）
AISA_KEY_A=
AISA_KEY_B=
# 单次请求最高价（美元），超价的请求会被拒绝
AISA_MAX_PRICE=0.02
# 调用日志（只记路径、槽位、花费，不记 Key）
AISA_CALL_LOG=

# 新词监控的可选数据源
GEFEI_API_KEY=
PRODUCTHUNT_TOKEN=
GH_TOKEN=
CACHE_TTL_H=18
ROOTS_TTL_H=24
